# Warden environment (dev, test, prod)
WARDEN_ENV=dev

# OWASP ZAP API infrastructure configuration
ZAP_BASE_URL=http://localhost:8080
ZAP_API_KEY=your-optional-zap-api-key-here

# Scan Target Configuration (separate authorized test target)
TARGET_BASE_URL=http://localhost:8000

# Scan defaults
TIMEOUT_SECONDS=30
OUTPUT_DIR=./reports
SCAN_TIMEOUT_SECONDS=300
POLL_INTERVAL_SECONDS=2

